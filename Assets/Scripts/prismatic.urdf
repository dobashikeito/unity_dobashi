<?xml version="1.0" ?>

<robot name="sliding_boxes">

  <!-- Define links -->
  <link name="base_link"/>

  <!-- First box -->
  <link name="box1">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <!-- Second box -->
  <link name="box2">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <!-- Define prismatic joint for sliding -->
  <joint name="sliding_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="box1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1" upper="1" effort="100" velocity="0.1"/>
  </joint>

  <!-- Connect the second box to the first one -->
  <joint name="box_joint" type="prismatic">
    <parent link="box1"/>
    <child link="box2"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1" upper="1" effort="100" velocity="0.1"/>
  </joint>

</robot>
