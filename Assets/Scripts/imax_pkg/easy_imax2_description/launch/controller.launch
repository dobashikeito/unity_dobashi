<launch>

<rosparam file="$(find easy_imax2_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="easy_imax2" args="1_position_controller 2_position_controller 3_position_controller 4_position_controller 5_position_controller 6_position_controller 7_position_controller 8_position_controller 9_position_controller 10_position_controller 11_position_controller 12_position_controller 13_position_controller 14_position_controller 15_position_controller 16_position_controller 17_position_controller 18_position_controller 19_position_controller 20_position_controller 21_position_controller 22_position_controller 23_position_controller 24_position_controller 25_position_controller 26_position_controller 27_position_controller 28_position_controller 29_position_controller 30_position_controller 31_position_controller 32_position_controller 33_position_controller 34_position_controller 35_position_controller 36_position_controller 37_position_controller 38_position_controller 39_position_controller 41_position_controller 42_position_controller 43_position_controller 44_position_controller 45_position_controller 46_position_controller 47_position_controller 48_position_controller 49_position_controller 50_position_controller 51_position_controller 52_position_controller 53_position_controller 54_position_controller 55_position_controller 56_position_controller 57_position_controller 58_position_controller 59_position_controller 60_position_controller 61_position_controller 62_position_controller 63_position_controller 64_position_controller 65_position_controller 66_position_controller 67_position_controller 68_position_controller 69_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/easy_imax2/joint_states"/>
</node>

</launch>