<launch>

<rosparam file="$(find simple_arm_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="simple_arm" args="1_position_controller 2_position_controller 3_position_controller 4_position_controller 5_position_controller 6_position_controller 7_position_controller 8_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/simple_arm/joint_states"/>
</node>

</launch>