<launch>

<rosparam file="$(find easy_imax10_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="easy_imax10" args="19_position_controller 20_position_controller 21_position_controller 22_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/easy_imax10/joint_states"/>
</node>

</launch>