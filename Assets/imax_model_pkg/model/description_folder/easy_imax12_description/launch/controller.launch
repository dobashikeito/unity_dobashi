<launch>

<rosparam file="$(find easy_imax12_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="easy_imax12" args="20_position_controller 21_position_controller 37_position_controller 38_position_controller 39_position_controller 40_position_controller 53_position_controller 54_position_controller 55_position_controller 56_position_controller 77_position_controller 79_position_controller 80_position_controller 81_position_controller 102_position_controller 103_position_controller 104_position_controller 105_position_controller 106_position_controller 108_position_controller 109_position_controller 110_position_controller 111_position_controller 115_position_controller 223_position_controller 224_position_controller 225_position_controller 226_position_controller 227_position_controller 228_position_controller 229_position_controller 230_position_controller 231_position_controller 252_position_controller 253_position_controller 254_position_controller 255_position_controller 272_position_controller 273_position_controller 274_position_controller 275_position_controller 276_position_controller 313_position_controller 314_position_controller 315_position_controller 316_position_controller 317_position_controller 318_position_controller 319_position_controller 320_position_controller 321_position_controller 358_position_controller 359_position_controller 360_position_controller 361_position_controller 362_position_controller 363_position_controller 364_position_controller 365_position_controller 366_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/easy_imax12/joint_states"/>
</node>

</launch>