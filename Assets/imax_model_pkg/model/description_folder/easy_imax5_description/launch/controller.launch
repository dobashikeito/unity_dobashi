er 83_position_controller 84_position_controller 85_position_controller 86_position_controller 87_position_controller 88_position_controller 89_position_controller 90_position_controller 91_position_controller 92_position_controller 93_position_controller 94_position_controller 95_position_controller 96_position_controller 97_position_controller 98_position_controller 99_position_controller 100_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
