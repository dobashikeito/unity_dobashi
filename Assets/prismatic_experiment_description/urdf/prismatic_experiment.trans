<?xml version="1.0" ?>
<robot name="prismatic_experiment" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="スライダ 3_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="スライダ 3">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="スライダ 3_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

