<launch>

<rosparam file="$(find prismatic_experiment_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="prismatic_experiment" args="スライダ 3_position_controller スライダ 6_position_controller スライダ 9_position_controller スライダ 12_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/prismatic_experiment/joint_states"/>
</node>

</launch>